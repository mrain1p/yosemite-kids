<?xml version="1.0" encoding="utf-8"?>
<!-- Cold-start window background: the logo on black instead of a bare black
     frame for the ~2 s before Compose's first frame. Android 12+ shows its own
     system splash first; older devices see only this. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@android:color/black" />
    <item
        android:width="120dp"
        android:height="120dp"
        android:gravity="center"
        android:drawable="@drawable/ic_launcher" />
</layer-list>
