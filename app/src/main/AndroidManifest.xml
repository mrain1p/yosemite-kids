<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Media3's network wake mode on phones: playback must not crash while
         holding CPU/Wi-Fi for screen-off listening. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Self-update: hand a downloaded APK to the system installer. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Offline downloads run as a foreground service with a progress notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Listen mode: audio keeps playing while the phone screen is off. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Google TV / Android TV: no touchscreen required, leanback optional so the
         same APK installs on phones, tablets and TV boxes. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:name=".YosemiteKidsApp"
        android:label="@string/app_name"
        android:banner="@drawable/tv_banner"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.YosemiteKids"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:hasFragileUserData="true"
        android:usesCleartextTraffic="true"><!-- phone→TV pairing runs plain HTTP on the home LAN -->
        <!-- The three backup attributes protect the parents' curation (blocks,
             safe-list, channels, screen-time rules) across reinstalls:
             cloud/device-transfer backup where the platform offers it, and
             hasFragileUserData adds a "Keep app data" choice on uninstall. -->

        <!-- configChanges like PlayerActivity: rotation must not tear down a
             pairing flow mid-approval (its dialog + polling live in activity
             state) — Compose relayouts on the new size by itself. -->
        <!-- The banner is declared twice on purpose: the application-level one
             is what Google TV reads, and some launchers (Fire TV among them)
             look for it on the leanback activity instead and fall back to the
             square icon when it isn't there. 16:9, mark + wordmark on brand
             teal, at every density — see scripts/Banner.java. -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:banner="@drawable/tv_banner"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Pairing deep link from the TV's QR code -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="yosemitekids" android:host="pair" />
            </intent-filter>
        </activity>

        <!-- The TV's way in, as its own alias rather than a second filter on
             MainActivity. One activity carrying both LAUNCHER and
             LEANBACK_LAUNCHER reads to some TV launchers as a phone app, and
             they draw the square icon stretched into the 16:9 card instead of
             the banner. The alias is leanback-only, so a TV sees a TV app and
             takes its banner; phones never show it (no LAUNCHER category), and
             it starts the same activity. -->
        <activity-alias
            android:name=".ui.TvLauncherActivity"
            android:targetActivity=".ui.MainActivity"
            android:exported="true"
            android:banner="@drawable/tv_banner"
            android:icon="@drawable/tv_banner"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Rotation and the picture-in-picture resize are handled in place
             (smallestScreenSize is what a PiP window changes): recreating
             the activity would restart playback. Phones only use PiP; the
             TV never asks for it. -->
        <activity
            android:name=".ui.PlayerActivity"
            android:exported="false"
            android:supportsPictureInPicture="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize" />

        <!-- Fetches parent-approved videos for offline play, one at a time. -->
        <service
            android:name=".data.DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Listen mode: keeps playback alive while the phone screen is off
             and puts a pause button on the lock screen. Phones only — started
             solely by PlayerActivity when the display actually turns off. -->
        <service
            android:name=".ui.ListenService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Serves the downloaded update APK to the system installer. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
